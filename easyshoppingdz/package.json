{
  "name": "easyshoppingdz",
  "version": "1.0.0",
  "private": true,
  "description": "EasyShoppingDZ - Algerian Online Megastore (Android app)",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o www/app.css --minify",
    "build:js": "esbuild src/native.js --bundle --minify --format=iife --outfile=www/native.js",
    "build": "npm run build:css && npm run build:js",
    "sync": "npm run build && cap sync android",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19"
  }
}
